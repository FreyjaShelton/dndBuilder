# Copy this file to .env and fill in your own value. .env is git-ignored.
# Google OAuth client ID for Google Drive sync. Not a secret (it ships in the built page), but it is
# kept out of the repo so each deployment can use its own client.
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application.
# Add this site's address (and http://localhost:3000 for local testing) under Authorized JavaScript origins.
# Until it is filled in, the app still saves characters on the device but shows Drive sync as not set up.
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
