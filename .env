# Google OAuth client ID for Google Drive sync (not a secret: it is visible in the page to anyone who loads it).
# This app has its own client, separate from the budget app's. Create it in Google Cloud Console ->
# APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application, and add this
# site's address (and http://localhost:3000 for local testing) under Authorized JavaScript origins.
# Until it is filled in, the app still saves characters on the device but shows Drive sync as not set up.
REACT_APP_GOOGLE_CLIENT_ID=524339747441-qchqsvf07k9hvl9kqpf06sg84pc5kg6p.apps.googleusercontent.com
